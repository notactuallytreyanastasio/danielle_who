  },
  "homepage": "https://github.com/notactuallytreyanastasio/danielle_who#readme",
  "dependencies": {
    "cheerio": "^1.1.2",
    "leaflet": "^1.9.4",
    "node-fetch": "^3.3.2",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "react-leaflet": "^5.0.0"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.1",
    "@types/leaflet": "^1.9.21",
