{
  "name": "danielle_who",
  "version": "1.0.0",
  "description": "The premise here is simple: we make an elegant/interesting way to browse the history of the universe of Dr Who, and find interesting things about it for fans. This will function as a jumping point for superfans who want to think in depth about the show itself. It also will be amusing for more casual fans.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "test": "vitest",
    "test:run": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/notactuallytreyanastasio/danielle_who.git"
  },
